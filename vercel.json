{
  "builds": [
    { "src": "server.py",    "use": "@vercel/python" },
    { "src": "index.html",   "use": "@vercel/static" },
    { "src": "dashboard.html","use": "@vercel/static" },
    { "src": "style.css",    "use": "@vercel/static" },
    { "src": "app.js",       "use": "@vercel/static" },
    { "src": "dashboard.css","use": "@vercel/static" },
    { "src": "database.js",  "use": "@vercel/static" },
    { "src": "dashboard.js", "use": "@vercel/static" },
    { "src": "manifest.json","use": "@vercel/static" },
    { "src": "sw.js",        "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)",      "dest": "server.py" },
    { "src": "/style.css",     "dest": "/style.css" },
    { "src": "/app.js",        "dest": "/app.js" },
    { "src": "/dashboard.css", "dest": "/dashboard.css" },
    { "src": "/database.js",   "dest": "/database.js" },
    { "src": "/dashboard.js",  "dest": "/dashboard.js" },
    { "src": "/dashboard.html","dest": "/dashboard.html" },
    { "src": "/manifest.json", "dest": "/manifest.json" },
    { "src": "/sw.js",         "dest": "/sw.js" },
    { "src": "/(.*)",          "dest": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
